# =====================================================================
# Variáveis para docker-compose.deploy.yml (setar no Coolify)
# =====================================================================

# Backend
PORT=8080
DB_HOST=SEU_HOST_DO_BANCO_EXTERNO
DB_PORT=5432
DB_USER=SEU_USUARIO
DB_PASSWORD=SUA_SENHA
DB_NAME=meuemprego
DB_SSLMODE=require
JWT_SECRET=TROQUE_POR_UMA_CHAVE_ALEATORIA_FORTE
JWT_EXPIRATION_HOURS=24

# Frontend — deve apontar para a API publicamente acessível
# Ex: https://api.meuemprego.pro/api/v1 (quando houver domínio)
VITE_API_URL=http://localhost:8080/api/v1
FRONTEND_PORT=8081